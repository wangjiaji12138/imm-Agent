# Application
IMM_AGENT_ENVIRONMENT=development
IMM_AGENT_LOG_LEVEL=INFO

# MySQL (used from task 03 onward)
IMM_AGENT_MYSQL_HOST=127.0.0.1
IMM_AGENT_MYSQL_PORT=3306
IMM_AGENT_MYSQL_DATABASE=imm_agent
IMM_AGENT_MYSQL_USER=imm_agent
IMM_AGENT_MYSQL_PASSWORD=change-me-for-local-development
IMM_AGENT_MYSQL_ROOT_PASSWORD=change-me-root-for-local-development

# Qdrant (used from task 03 onward)
IMM_AGENT_QDRANT_URL=http://127.0.0.1:6333
IMM_AGENT_QDRANT_COLLECTION=imm_agent_chunks_v1

# OpenAI-compatible embedding endpoint (required for task 20 reindex)
IMM_AGENT_EMBEDDING_URL=
IMM_AGENT_EMBEDDING_MODEL=
IMM_AGENT_EMBEDDING_API_KEY=
IMM_AGENT_EMBEDDING_DIMENSION=1536
IMM_AGENT_EMBEDDING_BATCH_SIZE=10

# Recommended first baseline: Alibaba Cloud Beijing text-embedding-v4.
# Copy these values into .env and add your Beijing API key locally.
# IMM_AGENT_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
# IMM_AGENT_EMBEDDING_MODEL=text-embedding-v4
# IMM_AGENT_EMBEDDING_DIMENSION=1024
# IMM_AGENT_QDRANT_COLLECTION=imm_agent_text_embedding_v4_1024_v1

# Model provider (used from task 22 onward)
IMM_AGENT_MODEL_PROVIDER=openai-compatible
IMM_AGENT_MODEL_URL=
IMM_AGENT_MODEL_NAME=
IMM_AGENT_MODEL_API_KEY=
IMM_AGENT_MODEL_TIMEOUT_SECONDS=30
IMM_AGENT_RATE_LIMIT_PER_MINUTE=30

# Example for Alibaba Cloud Model Studio Beijing (use a key for that region).
# IMM_AGENT_MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# IMM_AGENT_MODEL_NAME=qwen-plus
