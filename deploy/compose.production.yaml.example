name: imm-agent-production

services:
  mysql:
    image: mysql:8.4
    environment:
      MYSQL_DATABASE: ${IMM_AGENT_MYSQL_DATABASE}
      MYSQL_USER: ${IMM_AGENT_MYSQL_USER}
      MYSQL_PASSWORD: ${IMM_AGENT_MYSQL_PASSWORD}
      MYSQL_ROOT_PASSWORD: ${IMM_AGENT_MYSQL_ROOT_PASSWORD}
    volumes:
      - mysql_data:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u root -p$${MYSQL_ROOT_PASSWORD} --silent"]
      interval: 5s
      timeout: 5s
      retries: 20
    restart: unless-stopped

  qdrant:
    image: qdrant/qdrant:v1.15.5
    volumes:
      - qdrant_data:/qdrant/storage
    healthcheck:
      test: ["CMD-SHELL", "bash -c ':> /dev/tcp/127.0.0.1/6333'"]
      interval: 5s
      timeout: 3s
      retries: 20
    restart: unless-stopped

  backend:
    image: imm-agent-production-backend:${IMM_AGENT_RELEASE_TAG:-latest}
    build:
      context: ../backend
      dockerfile: Dockerfile.production
    env_file: ../.env
    environment:
      IMM_AGENT_ENVIRONMENT: production
      IMM_AGENT_MYSQL_HOST: mysql
      IMM_AGENT_MYSQL_PORT: 3306
      IMM_AGENT_QDRANT_URL: http://qdrant:6333
    depends_on:
      mysql:
        condition: service_healthy
      qdrant:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"]
      interval: 10s
      timeout: 3s
      retries: 20
    restart: unless-stopped

  frontend:
    image: imm-agent-production-frontend:${IMM_AGENT_RELEASE_TAG:-latest}
    build:
      context: ../frontend
      dockerfile: Dockerfile.production
    ports:
      - "${IMM_AGENT_PUBLIC_PORT:-8080}:80"
    depends_on:
      backend:
        condition: service_healthy
    restart: unless-stopped

volumes:
  mysql_data:
  qdrant_data:
